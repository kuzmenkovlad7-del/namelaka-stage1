    { "source": "/uploads/:path*", "destination": "http://46.62.234.91:18080/uploads/:path*" },
    { "source": "/app/:path*", "destination": "http://46.62.234.91:18080/app/:path*" },
    { "source": "/admin/:path*", "destination": "http://46.62.234.91:18080/admin/:path*" },

    { "source": "/ua/api/:path*", "destination": "http://46.62.234.91:18080/api/:path*" },
    { "source": "/ua/store/:path*", "destination": "http://46.62.234.91:18080/store/:path*" },
    { "source": "/ua/uploads/:path*", "destination": "http://46.62.234.91:18080/uploads/:path*" },
    { "source": "/ua/app/:path*", "destination": "http://46.62.234.91:18080/app/:path*" },
    { "source": "/ua/admin/:path*", "destination": "http://46.62.234.91:18080/admin/:path*" },

    { "source": "/ua/:path*", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
